<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/black">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/beacon_title"
        android:textColor="@color/yellow"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvBeaconStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/beacon_status_idle"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/beacon_keep_open"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/llBeaconList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnToggleBroadcast"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:text="@string/btn_start_broadcast"
        android:textSize="22sp"
        android:backgroundTint="@color/yellow"
        android:textColor="@color/black"
        android:contentDescription="@string/btn_start_broadcast" />

</LinearLayout>
