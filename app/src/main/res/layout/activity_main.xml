<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_pad"
        android:paddingEnd="@dimen/space_12"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_12">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_logo"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/space_12">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.NavGuide.Title" />

            <TextView
                android:id="@+id/tvMapName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_subtitle"
                android:textAppearance="@style/TextAppearance.NavGuide.Caption" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_settings" />
    </LinearLayout>

    <!-- Destination list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_pad"
            android:paddingEnd="@dimen/screen_pad"
            android:paddingBottom="@dimen/space_16">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_where_to"
                android:textAppearance="@style/TextAppearance.NavGuide.Display"
                android:layout_marginBottom="@dimen/space_20" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_rooms"
                android:textAppearance="@style/TextAppearance.NavGuide.Label"
                android:layout_marginBottom="@dimen/space_8" />

            <LinearLayout
                android:id="@+id/llRooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_access"
                android:textAppearance="@style/TextAppearance.NavGuide.Label"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_8" />

            <LinearLayout
                android:id="@+id/llAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_pad"
        android:paddingEnd="@dimen/screen_pad"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_20">

        <Button
            android:id="@+id/btnBeaconMode"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/btn_beacon_mode"
            android:textSize="16sp"
            app:cornerRadius="@dimen/radius_medium"
            app:icon="@drawable/ic_beacon"
            app:iconGravity="textStart"
            android:contentDescription="@string/btn_beacon_mode" />

        <Button
            android:id="@+id/btnSos"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_hero"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/btn_sos"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@color/danger_fill"
            android:textColor="@color/white"
            app:cornerRadius="@dimen/radius_medium"
            app:icon="@drawable/ic_sos"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            android:contentDescription="@string/sos_desc" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sos_hint"
            android:textAppearance="@style/TextAppearance.NavGuide.Caption"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_4" />
    </LinearLayout>

</LinearLayout>
