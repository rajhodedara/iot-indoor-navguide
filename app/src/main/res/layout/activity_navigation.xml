<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingStart="@dimen/screen_pad"
    android:paddingEnd="@dimen/screen_pad"
    android:paddingTop="@dimen/space_16">

    <TextView
        android:id="@+id/tvRouteTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_to_placeholder"
        android:textAppearance="@style/TextAppearance.NavGuide.Label"
        android:layout_marginBottom="@dimen/space_12" />

    <!-- Guidance card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="@dimen/space_20">

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_waiting_for_beacons"
            android:textAppearance="@style/TextAppearance.NavGuide.Display"
            android:textSize="28sp"
            android:lineSpacingMultiplier="1.15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_16">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_pin"
                android:tint="@color/amber"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_8"
                android:text="@string/nav_near_unknown"
                android:textAppearance="@style/TextAppearance.NavGuide.Caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_4">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_bluetooth"
                android:tint="@color/text_secondary"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvBluetooth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_8"
                android:text="@string/bt_checking"
                android:textAppearance="@style/TextAppearance.NavGuide.Caption" />
        </LinearLayout>
    </LinearLayout>

    <!-- Demo mode -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_demo_label"
        android:textAppearance="@style/TextAppearance.NavGuide.Label"
        android:layout_marginTop="@dimen/space_24"
        android:layout_marginBottom="@dimen/space_8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spSimNode"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.3" />

            <Button
                android:id="@+id/btnSimHop"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_8"
                android:text="@string/btn_sim_hop"
                android:textSize="14sp"
                app:cornerRadius="@dimen/radius_medium"
                android:contentDescription="@string/btn_sim_hop" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_8">

            <Button
                android:id="@+id/btnSimSteps"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/btn_sim_steps10"
                android:textSize="14sp"
                app:cornerRadius="@dimen/radius_medium"
                app:icon="@drawable/ic_steps"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                android:contentDescription="@string/btn_sim_steps10" />

            <Button
                android:id="@+id/btnAutoWalk"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_8"
                android:text="@string/btn_auto_walk"
                android:textSize="14sp"
                android:backgroundTint="@color/amber"
                android:textColor="@color/text_on_accent"
                app:cornerRadius="@dimen/radius_medium"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/text_on_accent"
                android:contentDescription="@string/btn_auto_walk" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnRepeat"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/btn_repeat"
        android:textSize="16sp"
        app:cornerRadius="@dimen/radius_medium"
        app:icon="@drawable/ic_repeat"
        app:iconGravity="textStart"
        android:contentDescription="@string/btn_repeat" />

    <Button
        android:id="@+id/btnStop"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_16"
        android:text="@string/btn_stop_nav"
        android:textSize="16sp"
        android:textColor="@color/danger_text"
        app:cornerRadius="@dimen/radius_medium"
        app:icon="@drawable/ic_stop"
        app:iconGravity="textStart"
        app:iconTint="@color/danger_text"
        android:contentDescription="@string/btn_stop_nav" />

</LinearLayout>
